[settings]
arch=x86_64
build_type=RelWithDebInfo
compiler=gcc
compiler.cppstd=17
compiler.libcxx=libstdc++11
compiler.version=13
os=Linux

# Work around issue https://github.com/conan-io/conan-center-index/issues/27912
qt/*:compiler.cppstd=gnu20 

[options]
# -c tools.system.package_manager:mode=install -c tools.system.package_manager:sudo=True --lockfile={skybolt_source_dir}/conan-shared.lock --lockfile-partial

[conf]
# Force the creation of dotenv files to be loaded by vscode
# See https://docs.conan.io/2/reference/tools/env/virtualbuildenv.html#generated-files
tools.env:dotenv=True

# Provide access to Skybolt's cmake files to any consumers of our Conan package
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

set(Skybolt_ASSETS_DIR "@Skybolt_ASSETS_DIR@")
set(Skybolt_BIN_DIR "@Skybolt_BIN_DIR@")
set(Skybolt_BUILD_SCRIPTS_DIR "@Skybolt_BUILD_SCRIPTS_DIR@")
set(Skybolt_DOCS_DIR "@Skybolt_DOCS_DIR@")
set(Skybolt_PLUGIN_DIRS "@Skybolt_PLUGIN_DIRS@")
set(Skybolt_PYTHON_MODULE_DIR "@Skybolt_PYTHON_MODULE_DIR@")